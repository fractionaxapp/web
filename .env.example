# Copy to .env.local and fill in. Real env files are git-ignored.

# Base URL of the FractionAX agents service (FastAPI). Used server-side by the
# /api/copilot and /api/deals proxy routes. Defaults to http://localhost:8000.
AGENTS_URL=

# --- On-chain (read) ---------------------------------------------------------
# Solana RPC endpoint. Defaults to https://api.devnet.solana.com when unset.
SOLANA_RPC_URL=
# Deployed program id. Defaults to the devnet deployment when unset.
FRACTIONAX_PROGRAM_ID=

# --- Super-admin dashboard ---------------------------------------------------
# Team allowlist: comma-separated emails permitted to sign in to /admin.
ADMIN_EMAILS=
# Shared team access key checked at admin login (alongside the email allowlist).
ADMIN_ACCESS_KEY=
# HMAC secret used to sign the admin session cookie. Use a long random string.
ADMIN_SESSION_SECRET=

# --- Super-admin on-chain signer (server-only; NEVER prefix with NEXT_PUBLIC_) --
# The program authority secret key, used server-side to sign privileged writes
# (register_deal, set_investor_credential, revoke_investor_credential). Set it to
# the JSON byte array from the authority's Solana keypair file (the contents of
# ~/.config/solana/id.json). Must be the same key as the on-chain Registry.authority.
# Leave unset to disable on-chain writes. NEVER expose with a NEXT_PUBLIC_ prefix.
SOLANA_AUTHORITY_SECRET=
# Shared key the web sends to the agents service for admin-only endpoints.
ADMIN_API_KEY=
